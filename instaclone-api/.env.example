# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4001

# PostgreSQL connection used by the application's pg client.
DATABASE_URL="postgresql://instaclone:instaclone_dev_pw@localhost:5432/instaclone?schema=public"

# Generate real secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# UI development server origin allowed by CORS
CORS_ORIGIN="http://localhost:4200"

# Set to true only when serving over HTTPS in production
COOKIE_SECURE=false
